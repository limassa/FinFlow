{
  "expo": {
    "name": "Claricash",
    "slug": "finflow-mobile",
    "version": "1.0.0",
    "newArchEnabled": false,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "lembretes-eventos"
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 35,
            "compileSdkVersion": 35,
            "ndkVersion": "27.1.12297006"
          },
          "ios": {
            "newArchEnabled": false
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lizsoftwares.finflow",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "O Claricash precisa acessar suas fotos para definir sua foto de perfil.",
        "NSCameraUsageDescription": "O Claricash precisa acessar a câmera para tirar sua foto de perfil.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.lizsoftwares.finflow"
    },
    "extra": {
      "eas": {
        "projectId": "fb24288c-dd63-4a4b-89f0-2c0b1c412154"
      }
    }
  }
}
