# Configurações do Banco de Dados - PRODUÇÃO
# Copie este arquivo para config.production.env e preencha com os dados reais
# NÃO commite o arquivo config.production.env com dados reais!

# Host do banco de dados (exemplo: railway, aws, etc)
DB_HOST=seu-host-producao.com

# Porta do banco de dados (geralmente 5432 para PostgreSQL)
DB_PORT=5432

# Nome do banco de dados
DB_NAME=nome-do-banco-producao

# Usuário do banco de dados
DB_USER=usuario-producao

# Senha do banco de dados
DB_PASSWORD=sua-senha-producao

